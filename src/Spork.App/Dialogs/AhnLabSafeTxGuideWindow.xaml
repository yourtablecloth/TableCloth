<Window x:Class="Spork.Dialogs.AhnLabSafeTxGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:TableCloth.Resources;assembly=TableCloth.Core"
        Style="{DynamicResource MainWindowStyle}"
        Title="{x:Static res:UIStringResources.AstxGuide_Title}"
        Width="500" MinWidth="460" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <StackPanel>
            <TextBlock Text="{x:Static res:UIStringResources.AstxGuide_Title}" FontSize="16" FontWeight="Bold" Margin="0 0 0 8" />
            <TextBlock Text="{x:Static res:UIStringResources.AstxGuide_Description}" TextWrapping="Wrap"
                       Foreground="{DynamicResource ControlSecondaryForeground}" Margin="0 0 0 14" />

            <!-- B: 시각 가이드 — ASTx 설정 창에서 찾아 '체크 해제'해야 할 항목을 그림으로 보여준다. -->
            <TextBlock Text="{x:Static res:UIStringResources.AstxGuide_VisualCaption}" Margin="0 0 0 6" />
            <Border BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="6" Padding="14 12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- 체크 해제된 상태를 나타내는 목업 체크박스(빈 상자) -->
                    <Border Grid.Column="0" Width="20" Height="20" BorderBrush="#888888" BorderThickness="2"
                            CornerRadius="3" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Static res:UIStringResources.AstxGuide_SettingLabel}"
                               Margin="12 0 0 0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Grid.Column="2" Text="{x:Static res:UIStringResources.AstxGuide_UncheckHere}"
                               Foreground="#D13438" FontWeight="Bold" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 단계별 안내 -->
            <TextBlock Text="{x:Static res:UIStringResources.AstxGuide_Steps}" TextWrapping="Wrap" LineHeight="23" Margin="0 16 0 14" />

            <Button Content="{x:Static res:UIStringResources.AstxGuide_OpenSettingsButton}"
                    Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Left" Padding="16 6" Margin="0 0 0 16" />

            <!-- A: 확인 게이트 — 해제 완료를 체크해야 '계속'이 활성화된다. -->
            <CheckBox IsChecked="{Binding IsConfirmed}" Margin="0 0 0 18">
                <TextBlock Text="{x:Static res:UIStringResources.AstxGuide_ConfirmCheckbox}" TextWrapping="Wrap" />
            </CheckBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static res:UIStringResources.AstxGuide_SkipButton}"
                        Command="{Binding SkipCommand}" Padding="12 6" Margin="0 0 8 0" />
                <Button Content="{x:Static res:UIStringResources.AstxGuide_ContinueButton}"
                        Command="{Binding ContinueCommand}" IsDefault="True" Padding="18 6" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
