<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:TableCloth.Resources"
        x:Class="Spork.Dialogs.SiteReportWindow"
        Title="{x:Static res:UIStringResources.SiteReport_WindowTitle}"
        Width="480" Height="360" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20" RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0"
                   Text="{x:Static res:UIStringResources.SiteReport_Description}"
                   TextWrapping="Wrap"
                   Margin="0 0 0 15" />

        <StackPanel Grid.Row="1" VerticalAlignment="Top" Spacing="10">
            <Border Background="{DynamicResource InfoBannerBackground}"
                    BorderBrush="{DynamicResource InfoBannerBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="15" Cursor="Hand"
                    Tapped="GoogleFormsButton_Click">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{x:Static res:UIStringResources.SiteReport_GoogleFormsButton}"
                                   FontWeight="Bold" FontSize="14" Margin="0 0 0 5" />
                        <TextBlock Text="{x:Static res:UIStringResources.SiteReport_GoogleFormsDescription}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ControlSecondaryForeground}" FontSize="12" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="→" FontSize="20" VerticalAlignment="Center" Margin="10 0 0 0" />
                </Grid>
            </Border>

            <Border Background="{DynamicResource InfoBannerBackground}"
                    BorderBrush="{DynamicResource InfoBannerBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="15" Cursor="Hand"
                    Tapped="GitHubIssueButton_Click">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{x:Static res:UIStringResources.SiteReport_GitHubIssueButton}"
                                   FontWeight="Bold" FontSize="14" Margin="0 0 0 5" />
                        <TextBlock Text="{x:Static res:UIStringResources.SiteReport_GitHubIssueDescription}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ControlSecondaryForeground}" FontSize="12" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="→" FontSize="20" VerticalAlignment="Center" Margin="10 0 0 0" />
                </Grid>
            </Border>
        </StackPanel>

        <Button Grid.Row="2" Content="{x:Static res:UIStringResources.Button_CloseButton}"
                HorizontalAlignment="Right" Padding="20 8" Margin="0 15 0 0"
                Click="CloseButton_Click" />
    </Grid>
</Window>
