<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:TableCloth.Resources"
        x:Class="Spork.Dialogs.IdleLogoutWarningWindow"
        Title="{x:Static res:UIStringResources.Sandbox_IdleLogout_WarningTitle}"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" />
        <Button x:Name="KeepUsingButton" Margin="0 18 0 0" Padding="18 6" HorizontalAlignment="Right"
                Content="{x:Static res:UIStringResources.Sandbox_IdleLogout_KeepUsingButton}"
                Click="KeepUsingButton_Click" IsDefault="True" />
    </StackPanel>
</Window>
