<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.18362.0</TargetFramework>
		<!-- 이슈 #296: WPF → Avalonia. UseWPF 제거. -->
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<LangVersion>preview</LangVersion>
		<!-- 이슈 #296: 신규/이관 파일이 nullable 주석(?)을 쓰므로 annotations 컨텍스트 활성화(경고는 미발생 —
		     nullable 미대응 레거시 파일 보호). App.xaml.cs 의 파일별 #nullable enable annotations 를 대체. -->
		<Nullable>annotations</Nullable>
		<Deterministic>true</Deterministic>
		<!-- 이슈 #296: WPF 제거 후 비문자열 resx(Signature 등) 를 빌드하려면 이 설정 + System.Resources.Extensions 가 필요. -->
		<GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
		<!-- GeneratedComInterface/LibraryImport(소스젠 상호운용)에는 unsafe 블록이 필요(SYSLIB1062). -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!--
			RootNamespace는 의도적으로 'Spork'로 설정. 본 라이브러리의 어셈블리 이름은
			'Spork.App'이지만 내부 파일들은 기존 'Spork.Components', 'Spork.ViewModels',
			'Spork.Steps' 등의 네임스페이스를 그대로 유지하기 위함. 진입점 프로젝트(Spork)와
			공통 네임스페이스 공간을 공유하므로 using 문 수정 없이 파일 이동이 가능하다.
		-->
		<RootNamespace>Spork</RootNamespace>
		<Description>Spork sandbox agent module — registered into the unified binary via builder.UseSpork() or via a standalone Spork.exe entry point.</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AsyncAwaitBestPractices.MVVM" />
		<!-- 이슈 #296: Avalonia UI 스택 -->
		<PackageReference Include="Avalonia" />
		<PackageReference Include="Avalonia.Desktop" />
		<PackageReference Include="Avalonia.Themes.Fluent" />
		<PackageReference Include="Avalonia.Fonts.Inter" />
		<PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="Microsoft.Extensions.Configuration" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
		<PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" />
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" />
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Extensions.Hosting" />
		<PackageReference Include="Microsoft.Extensions.Http" />
		<PackageReference Include="Microsoft.Extensions.Logging" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
		<PackageReference Include="Microsoft.Extensions.Logging.EventLog" />
		<PackageReference Include="Sentry" />
		<PackageReference Include="Sentry.Serilog" />
		<PackageReference Include="Serilog" />
		<PackageReference Include="Serilog.Extensions.Logging" />
		<PackageReference Include="System.CommandLine" />
		<!-- 이슈 #296: WPF 제거로 암시 제공되던 System.Drawing(샌드박스 배경 이미지) / 비문자열 resx /
		     X509Certificate2UI(인증서 상세 창) 지원을 명시 참조. -->
		<PackageReference Include="System.Drawing.Common" />
		<PackageReference Include="System.Resources.Extensions" />
		<PackageReference Include="System.Windows.Extensions" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TableCloth.Core\TableCloth.Core.csproj" />
	</ItemGroup>

	<!--
		AOT 안전 COM 헬퍼(GeneratedComInterface). netstandard2.0인 TableCloth.Core에는 둘 수 없어
		src/Shared 에 두고 net10 모듈들이 공유 링크한다. TableCloth.App 도 동일하게 링크한다.
	-->
	<ItemGroup>
		<Compile Include="..\Shared\Interop\NativeShellLink.cs" Link="Interop\NativeShellLink.cs" />
		<!-- 이슈 #296: 원격 이미지(About 창 GitHub 아바타) 비동기 로더. 양 앱 공유 링크. -->
		<Compile Include="..\Shared\Controls\RemoteImageLoader.cs" Link="Controls\RemoteImageLoader.cs" />
		<Compile Include="..\Shared\Controls\WindowChrome.cs" Link="Controls\WindowChrome.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- 진입점(Spork) 프로젝트와 테스트가 본 라이브러리의 internal API에 접근 가능하게 한다. -->
		<InternalsVisibleTo Include="Spork" />
		<InternalsVisibleTo Include="Spork.Test" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Resources\Signature.jpg" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

</Project>
