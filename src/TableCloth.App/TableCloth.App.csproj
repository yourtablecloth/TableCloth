<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.18362.0</TargetFramework>
		<!-- 이슈 #296: WPF → Avalonia. UseWPF 제거. -->
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<!-- 이슈 #296 Stage 2(M5): dev 빌드에서 트림/AOT/단일파일 분석기를 상시 켜 회귀를 조기 차단.
		     (netstandard2.0 인 TableCloth.Core 는 NETSDK1210 이라 제외 — 전체 프로그램 검증은 진입점 PublishAot 이 담당.) -->
		<IsAotCompatible>true</IsAotCompatible>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<Deterministic>true</Deterministic>
		<!-- GeneratedComInterface/LibraryImport(소스젠 상호운용)에는 unsafe 블록이 필요(SYSLIB1062). -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- 이슈 #296: WPF 제거 후 비문자열 resx(SandboxIcon 등) 를 빌드하려면 이 설정 + System.Resources.Extensions 필요. -->
		<GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
		<!--
			RootNamespace는 의도적으로 'TableCloth'로 설정. 본 라이브러리의 어셈블리 이름은
			'TableCloth.App'이지만 내부 파일들은 기존 'TableCloth.Components', 'TableCloth.ViewModels',
			'TableCloth.Pages' 등의 네임스페이스를 그대로 유지하기 위함.
		-->
		<RootNamespace>TableCloth</RootNamespace>
		<Description>TableCloth host launcher module — registered into the unified binary via builder.UseTableCloth().</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AsyncAwaitBestPractices.MVVM" />
		<!-- 이슈 #296: Avalonia UI 스택 -->
		<PackageReference Include="Avalonia" />
		<PackageReference Include="Avalonia.Desktop" />
		<PackageReference Include="Avalonia.Themes.Fluent" />
		<PackageReference Include="Avalonia.Fonts.Inter" />
		<PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Extensions.Hosting" />
		<PackageReference Include="Microsoft.Extensions.Http" />
		<PackageReference Include="PnPeople.Security" />
		<PackageReference Include="Sentry.Serilog" />
		<PackageReference Include="Serilog.Extensions.Logging" />
		<PackageReference Include="Serilog.Sinks.File" />
		<PackageReference Include="System.CommandLine" />
		<!-- 이슈 #296: WPF 제거로 암시 제공되던 System.Drawing(사이트 이미지 처리) / 비문자열 resx 지원을 명시 참조. -->
		<PackageReference Include="System.Drawing.Common" />
		<PackageReference Include="System.Resources.Extensions" />
		<PackageReference Include="Velopack" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TableCloth.Core\TableCloth.Core.csproj" />
	</ItemGroup>

	<!--
		AOT 안전 COM 헬퍼(GeneratedComInterface). netstandard2.0인 TableCloth.Core에는 둘 수 없어
		src/Shared 에 두고 net10 모듈들이 공유 링크한다. Spork.App 도 동일하게 링크한다.
	-->
	<ItemGroup>
		<Compile Include="..\Shared\Interop\NativeShellLink.cs" Link="Interop\NativeShellLink.cs" />
		<!-- 이슈 #296: 원격 이미지(About 창 GitHub 아바타) 비동기 로더. 양 앱 공유 링크. -->
		<Compile Include="..\Shared\Controls\RemoteImageLoader.cs" Link="Controls\RemoteImageLoader.cs" />
		<Compile Include="..\Shared\Controls\WindowChrome.cs" Link="Controls\WindowChrome.cs" />
		<!-- 이슈 #296(AOT): About 창 OSS 크레딧 정적 목록(리플렉션 대체). 양 앱 공유 링크. -->
		<Compile Include="..\Shared\Components\ThirdPartyLicenses.cs" Link="Components\ThirdPartyLicenses.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- 진입점(TableCloth) 프로젝트와 테스트가 본 라이브러리의 internal API에 접근 가능하게 한다. -->
		<InternalsVisibleTo Include="TableCloth" />
		<InternalsVisibleTo Include="TableCloth.Test" />
		<InternalsVisibleTo Include="TableCloth.SpecFlow" />
	</ItemGroup>

	<ItemGroup>
		<!-- 이슈 #296: 스플래시가 avares://TableCloth.App/Resources/SandboxIcon.png 로 로드(WPF Resource → AvaloniaResource). -->
		<AvaloniaResource Include="Resources\SandboxIcon.png" />
		<!-- 이슈 #296(AOT): 바로가기 아이콘 폴백용 원본 .ico 를 원시 바이트로 임베드(LogicalName 고정).
		     resx System.Drawing.Icon(SandboxIconWin32) 역직렬화(AOT 실패)를 우회해 GetManifestResourceStream 으로 직접 읽는다. -->
		<EmbeddedResource Include="Resources\SandboxIcon.ico">
			<LogicalName>SandboxIcon.ico</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Components\Implementations\LicenseDescriptor.cs">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Compile>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

</Project>
