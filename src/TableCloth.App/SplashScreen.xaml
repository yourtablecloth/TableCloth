<Window x:Class="TableCloth.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TableCloth.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:tablecloth="clr-namespace:TableCloth;assembly=TableCloth.Core"
        xmlns:res="clr-namespace:TableCloth.Resources;assembly=TableCloth.Core"
        xmlns:xrpb="http://XamlRadialProgressBar/DotNet"
        mc:Ignorable="d"
        Title="{x:Static res:UIStringResources.MainWindow_Title}" Height="{Binding SplashWindowHeight}" Width="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Style="{DynamicResource MainWindowStyle}"
        MouseDown="Window_MouseDown"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        d:DataContext="{d:DesignInstance Type=vm:SplashScreenViewModelForDesigner, IsDesignTimeCreatable=True}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding SplashScreenLoadedCommand}">
                <i:InvokeCommandAction.CommandParameter>
                    <Binding Path="DataContext" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}" />
                </i:InvokeCommandAction.CommandParameter>
            </i:InvokeCommandAction>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border CornerRadius="5" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2.0*"/>
                <RowDefinition Height="1.3*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Height="100" Margin="0,0,0,20" Source="/TableCloth.App;component/Resources/SandboxIcon.png"/>
                <TextBlock Text="{x:Static res:CommonStrings.AppName}" FontSize="24" FontWeight="Bold" TextAlignment="Center" />
                <TextBlock Text="{Binding AppVersion}" TextAlignment="Center" />
                <TextBlock Text="{Binding Source={x:Static res:UIStringResources.Build_Debug}}" TextAlignment="Center" Visibility="{Binding Source={x:Static tablecloth:Helpers.IsDevelopmentBuild}, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <!-- Progress Indicator -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Indeterminate Progress (when not updating) -->
                <xrpb:RadialProgressBar ArcMode="Fill" ArcDirection="Counterclockwise" ShapeModeStep="2" ArcRotationDegree="90"
                                        ShapeModeWidth="32" Width="100" Height="100" IsIndeterminate="True" 
                                        Foreground="{DynamicResource ControlDefaultForeground}"
                                        Visibility="{Binding ShowBusyIndicator, Converter={StaticResource BooleanToVisibilityConverter}}" />
                
                <!-- Update Progress Bar (when downloading update) -->
                <Grid Visibility="{Binding ShowUpdateProgress, Converter={StaticResource BooleanToVisibilityConverter}}" Width="300" Height="100">
                    <StackPanel VerticalAlignment="Center">
                        <ProgressBar Height="20" Minimum="0" Maximum="100" Value="{Binding UpdateProgress}" />
                        <TextBlock Text="{Binding UpdateProgress, StringFormat={}{0}%}" HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="14" />
                    </StackPanel>
                </Grid>
                
                <TextBlock Text="{Binding Status}" HorizontalAlignment="Center" Margin="0,10,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" />

                <!--
                    딥링크(`tablecloth:`)로 시작된 경우의 종착 화면. 링크가 제대로 인식됐다는 사실과
                    대상 사이트 이름을 보여주고, 이어서 무엇을 할지 고르게 한다. 인식 실패는 여기까지
                    오지 않고 평소대로 메인 창이 열린다(App.ViewModel_InitializeDone).
                -->
                <StackPanel MaxWidth="460" Margin="0,12,0,0"
                            Visibility="{Binding ShowDeepLinkActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding DeepLinkResultMessage}" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button Content="{x:Static res:UIStringResources.Splash_DeepLink_CloseButton}"
                                Command="{Binding CloseAfterDeepLinkCommand}" Padding="16,6" Margin="0,0,6,0" />
                        <!-- '다시 시도'는 실패했을 때만 의미가 있다. -->
                        <Button Content="{x:Static res:UIStringResources.Splash_DeepLink_RetryButton}"
                                Command="{Binding RetryDeepLinkLaunchCommand}" Padding="16,6" Margin="0,0,6,0"
                                Visibility="{Binding DeepLinkLaunchSucceeded, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        <Button Content="{x:Static res:UIStringResources.Splash_DeepLink_OpenAppButton}"
                                Command="{Binding OpenTableClothCommand}" Padding="16,6" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
