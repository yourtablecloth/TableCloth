<Window x:Class="TableCloth.Dialogs.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TableCloth.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:res="clr-namespace:TableCloth.Resources;assembly=TableCloth.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:OptionsWindowViewModelForDesigner, IsDesignTimeCreatable=True}"
        Style="{DynamicResource MainWindowStyle}"
        Title="{x:Static res:UIStringResources.Options_Title}" Width="560" Height="520" MinWidth="460" MinHeight="440"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding OptionsWindowLoadedCommand}">
                <i:InvokeCommandAction.CommandParameter>
                    <Binding Path="DataContext" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}" />
                </i:InvokeCommandAction.CommandParameter>
            </i:InvokeCommandAction>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" SelectedIndex="{Binding InitialTabIndex}">
            <!-- 사용자 폴더 -->
            <TabItem Header="{x:Static res:UIStringResources.QuickStart_Section_UserFolders}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0 0 0 8" TextWrapping="Wrap"
                               Foreground="{DynamicResource ControlSecondaryForeground}"
                               Text="{x:Static res:UIStringResources.MappedFolder_Description}" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding MappedFolders}" SelectedItem="{Binding SelectedMappedFolder}" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding HostFolder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding HostFolder}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                                        <Setter Property="Foreground" Value="Gray" />
                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border Grid.Column="1" BorderBrush="{Binding ReadOnly, Converter={StaticResource BooleanToBackgroundConverter}}" BorderThickness="1" CornerRadius="3" Padding="5 2" Margin="5 0 0 0"
                                            Visibility="{Binding IsUnavailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding ReadOnly, Converter={StaticResource BooleanToReadOnlyTextConverter}}" FontSize="11" />
                                    </Border>
                                    <Border Grid.Column="1" BorderBrush="Red" BorderThickness="1" CornerRadius="3" Padding="5 2" Margin="5 0 0 0"
                                            Visibility="{Binding IsUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{x:Static res:UIStringResources.MappedFolder_Unavailable}" Foreground="Red" FontSize="11" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0 8 0 0">
                        <Button Content="{x:Static res:UIStringResources.MappedFolder_AddButton}" Command="{Binding AddMappedFolderCommand}" Padding="10 5" Margin="0 0 6 0" />
                        <Button Content="{x:Static res:UIStringResources.MappedFolder_RemoveButton}" Command="{Binding RemoveMappedFolderCommand}" IsEnabled="{Binding SelectedMappedFolder, Converter={StaticResource NullToBooleanConverter}}" Padding="10 5" Margin="0 0 6 0" />
                        <Button Content="{x:Static res:UIStringResources.MappedFolder_ToggleReadOnlyButton}" Command="{Binding ToggleMappedFolderReadOnlyCommand}" IsEnabled="{Binding SelectedMappedFolder, Converter={StaticResource NullToBooleanConverter}}" Padding="10 5" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 데이터 디렉터리 -->
            <TabItem Header="{x:Static res:UIStringResources.QuickStart_Section_DataDirectory}">
                <StackPanel Margin="12">
                    <TextBlock Margin="0 0 0 8" TextWrapping="Wrap"
                               Foreground="{DynamicResource ControlSecondaryForeground}"
                               Text="{x:Static res:UIStringResources.QuickStart_DataDirectory_Description}" />
                    <TextBlock Margin="0 4 0 2" FontWeight="SemiBold"
                               Text="{x:Static res:UIStringResources.QuickStart_DataDirectory_CurrentPathLabel}" />
                    <TextBox Margin="0 0 0 8" IsReadOnly="True" TextWrapping="Wrap"
                             Text="{Binding DataDirectoryDisplayPath, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{x:Static res:UIStringResources.QuickStart_DataDirectory_SelectButton}" Command="{Binding SelectDataDirectoryCommand}" Padding="10 5" Margin="0 0 6 0" />
                        <Button Content="{x:Static res:UIStringResources.QuickStart_DataDirectory_ResetButton}" Command="{Binding ResetDataDirectoryCommand}" IsEnabled="{Binding DataDirectoryIsCustom}" Padding="10 5" Margin="0 0 6 0" />
                        <Button Content="{x:Static res:UIStringResources.QuickStart_DataDirectory_OpenButton}" Command="{Binding OpenDataDirectoryCommand}" Padding="10 5" />
                    </StackPanel>
                    <Border Margin="0 10 0 0" BorderBrush="Red" BorderThickness="1" CornerRadius="3" Padding="8"
                            Visibility="{Binding DataDirectoryIsNonLocal, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock TextWrapping="Wrap" Foreground="Red"
                                   Text="{x:Static res:UIStringResources.QuickStart_DataDirectory_NonLocalWarning}" />
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- 인증서 (NPKI 공유) -->
            <TabItem Header="{x:Static res:UIStringResources.Options_Section_Certificate}">
                <StackPanel Margin="12">
                    <TextBlock Margin="0 0 0 8" TextWrapping="Wrap"
                               Foreground="{DynamicResource ControlSecondaryForeground}"
                               Text="{Binding CertificateSectionDescription}" />
                    <CheckBox Margin="0 4" Content="{x:Static res:UIStringResources.Option_ShareNpkiCheckbox}" IsChecked="{Binding ShareNpkiFolder}" />
                </StackPanel>
            </TabItem>

            <!-- 장치 공유 -->
            <TabItem Header="{x:Static res:UIStringResources.Options_Section_DeviceSharing}">
                <StackPanel Margin="12">
                    <TextBlock Margin="0 0 0 8" TextWrapping="Wrap"
                               Foreground="{DynamicResource ControlSecondaryForeground}"
                               Text="{x:Static res:UIStringResources.Options_Section_DeviceSharing_Description}" />
                    <CheckBox Margin="0 4" Content="{x:Static res:UIStringResources.Option_UseMicrophoneCheckboxText}" IsChecked="{Binding EnableMicrophone}" />
                    <CheckBox Margin="0 4" Content="{x:Static res:UIStringResources.Option_UseWebCameraCheckboxText}" IsChecked="{Binding EnableWebCam}" />
                    <CheckBox Margin="0 4" Content="{x:Static res:UIStringResources.Option_UsePrinterCheckboxText}" IsChecked="{Binding EnablePrinters}" />
                    <!-- '프린터 연결'을 켜면 샌드박스 안에서 프린터 소프트웨어(모두의 프린터 등)가 준비된다고
                         오해하기 쉬워, 호스트 프린터 공유와 가상 프린터 앱 설치의 차이를 항상 보이도록 안내한다(이슈 #242). -->
                    <TextBlock Margin="22 2 0 0" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource ControlSecondaryForeground}"
                               Text="{x:Static res:UIStringResources.Option_UsePrinterCheckbox_Description}" />
                </StackPanel>
            </TabItem>

<!-- 호환성 (워크어라운드) -->
            <TabItem Header="{x:Static res:UIStringResources.Options_Section_Compatibility}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0 0 0 8" TextWrapping="Wrap"
                               Foreground="{DynamicResource ControlSecondaryForeground}"
                               Text="{x:Static res:UIStringResources.Options_Section_Compatibility_Description}" />

                    <!-- 설정 항목의 이름·설명(한/영)을 검색해 필터링한다. 항목이 늘어나도 원하는 설정을 빠르게 찾게 한다.
                         워터마크는 카탈로그 검색(CatalogPage)과 동일한 CueBannerBrush 관용구를 사용한다(빈 값일 때만 표시). -->
                    <TextBox Grid.Row="1" Margin="0 0 0 8" VerticalContentAlignment="Center"
                             Text="{Binding CompatibilityOptionSearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                <Style.Resources>
                                    <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                        <VisualBrush.Visual>
                                            <Label Content="{x:Static res:UIStringResources.Option_Compatibility_SearchPlaceholder}" Foreground="{DynamicResource ControlSecondaryForeground}" />
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Style.Resources>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="{x:Static sys:String.Empty}">
                                        <Setter Property="Background" Value="{StaticResource CueBannerBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- 체크박스 목록은 수직 전용 스크롤로 감싼다(가로 스크롤 비활성 + 설명 줄바꿈). 항목이 늘어나도 창 높이를 넘지 않는다. -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding CompatibilityOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CompatibilityOptionItem}">
                                        <StackPanel Margin="0 0 0 12">
                                            <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                            <TextBlock Margin="22 2 0 0" TextWrapping="Wrap" FontSize="11"
                                                       Foreground="{DynamicResource ControlSecondaryForeground}"
                                                       Text="{Binding Description}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="2 4 0 0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ControlSecondaryForeground}"
                                       Text="{x:Static res:UIStringResources.Option_Compatibility_NoSearchResults}"
                                       Visibility="{Binding HasNoCompatibilityMatches, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

<!-- 진단 -->
            <TabItem Header="{x:Static res:UIStringResources.Options_Section_Diagnostics}">
                <StackPanel Margin="12">
                    <TextBlock Margin="0 0 0 8" TextWrapping="Wrap"
                               Foreground="{DynamicResource ControlSecondaryForeground}"
                               Text="{x:Static res:UIStringResources.Option_TelemetryDescriptionText}" />
                    <CheckBox Margin="0 4" Content="{x:Static res:UIStringResources.Option_UseAutoLogCollecting}" IsChecked="{Binding EnableLogAutoCollecting}" />
                </StackPanel>
            </TabItem>

            <!-- 미리 보기(Preview): 실험적 기능. 현재는 유휴 자동 종료(이슈 #197) 한 가지. 기본 꺼짐. -->
            <TabItem Header="{x:Static res:UIStringResources.Options_Section_Preview}">
                <StackPanel Margin="12">
                    <TextBlock Margin="0 0 0 8" TextWrapping="Wrap"
                               Foreground="{DynamicResource ControlSecondaryForeground}"
                               Text="{x:Static res:UIStringResources.Options_Section_Preview_Description}" />

                    <!-- 이슈 #296: 업데이트 릴리스 링(안정/미리 보기). 안정=현행, 미리 보기=선행(AOT 전환본) 프리릴리스. -->
                    <TextBlock Margin="0 4 0 2" FontWeight="SemiBold"
                               Text="{x:Static res:UIStringResources.Option_UpdateChannel_Label}" />
                    <TextBlock Margin="0 0 0 4" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource ControlSecondaryForeground}"
                               Text="{x:Static res:UIStringResources.Option_UpdateChannel_Description}" />
                    <RadioButton Margin="0 2" GroupName="UpdateChannel"
                                 Content="{x:Static res:UIStringResources.Option_UpdateChannel_Retail}"
                                 IsChecked="{Binding SelectedUpdateChannel, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Retail}" />
                    <RadioButton Margin="0 2" GroupName="UpdateChannel"
                                 Content="{x:Static res:UIStringResources.Option_UpdateChannel_Preview}"
                                 IsChecked="{Binding SelectedUpdateChannel, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Preview}" />
                    <TextBlock Margin="22 2 0 0" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource ControlSecondaryForeground}"
                               Text="{x:Static res:UIStringResources.Option_UpdateChannel_PreviewWarning}" />

                    <Separator Margin="0 12" />

                    <CheckBox Margin="0 4" Content="{x:Static res:UIStringResources.Option_EnableIdleAutoLogout}" IsChecked="{Binding EnableIdleAutoLogout}" />
                    <TextBlock Margin="22 2 0 0" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource ControlSecondaryForeground}"
                               Text="{x:Static res:UIStringResources.Option_EnableIdleAutoLogout_Description}" />
                    <StackPanel Orientation="Horizontal" Margin="22 8 0 0" VerticalAlignment="Center"
                                IsEnabled="{Binding EnableIdleAutoLogout}">
                        <TextBlock VerticalAlignment="Center" Margin="0 0 8 0"
                                   Text="{x:Static res:UIStringResources.Option_IdleAutoLogout_MinutesLabel}" />
                        <ComboBox Width="80" VerticalAlignment="Center"
                                  ItemsSource="{Binding IdleTimeoutOptions}"
                                  SelectedItem="{Binding IdleAutoLogoutMinutes}" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 12 0 0">
            <Button x:Name="CloseButton" Padding="14 6" Content="{x:Static res:UIStringResources.Options_CloseButton}" Click="CloseButton_Click" IsDefault="True" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
