<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TableCloth.ViewModels"
        xmlns:sponsors="using:TableCloth.Models.Sponsors"
        xmlns:controls="using:TableCloth.Controls"
        xmlns:res="using:TableCloth.Resources"
        x:Class="TableCloth.Dialogs.AboutWindow"
        x:DataType="vm:AboutWindowViewModel"
        Title="{x:Static res:UIStringResources.AboutWindow_Title}" Width="640" Height="520"
        MinWidth="320" MinHeight="280" CanResize="False" WindowStartupLocation="CenterOwner">
    <Grid Margin="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">

        <!-- Info Banner (WPF Hyperlink → 링크형 Button) -->
        <Border Grid.Row="0"
                Background="{DynamicResource InfoBannerBackground}"
                BorderBrush="{DynamicResource InfoBannerBorder}"
                BorderThickness="1" Padding="10" Margin="0 0 0 10" CornerRadius="4">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="ⓘ" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource InfoBannerLinkForeground}" />
                <TextBlock Text="{x:Static res:UIStringResources.Sponsor_BannerMessage}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Foreground="{DynamicResource InfoBannerForeground}" />
                <Button Classes="link" Content="{x:Static res:UIStringResources.Sponsor_BannerDetailLink}"
                        Click="SponsorBanner_Click" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Legal Notice -->
        <StackPanel Grid.Row="1" Margin="0 0 0 10">
            <TextBlock Text="{x:Static res:UIStringResources.AboutWindow_CopyrightText}" />
            <TextBlock Text="{x:Static res:UIStringResources.AboutWindow_TrademarkText}"
                       Foreground="{DynamicResource ControlSecondaryForeground}" FontSize="11" />
        </StackPanel>

        <!-- Version Info -->
        <Grid Grid.Row="2" Margin="0 0 0 10" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:UIStringResources.AboutWindow_AppVersionText}" Margin="0 0 10 2" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppVersion}" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:UIStringResources.AboutWindow_CatalogDateText}" Margin="0 2 10 0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CatalogDate}" FontWeight="SemiBold" />
        </Grid>

        <!-- Sponsors (원격 아바타는 M3 이월 → 플레이스홀더) -->
        <StackPanel Grid.Row="3" Margin="0 0 0 10" IsVisible="{Binding HasSponsors}">
            <TextBlock Text="{x:Static res:UIStringResources.AboutWindow_SponsorsTitle}" FontWeight="SemiBold" Margin="0 0 0 6" />
            <Grid ColumnDefinitions="*,Auto">
                <ItemsControl Grid.Column="0" ItemsSource="{Binding Sponsors}" MaxHeight="36" ClipToBounds="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sponsors:SponsorInfo">
                            <Border Margin="0 0 8 4" Padding="6 4" CornerRadius="4" BorderThickness="1"
                                    Background="{DynamicResource InfoBannerBackground}" BorderBrush="{DynamicResource InfoBannerBorder}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True" Background="#80808080">
                                        <Image controls:RemoteImageLoader.SourceUrl="{Binding AvatarUrl}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="..." VerticalAlignment="Center" FontWeight="Bold" Margin="4 0 0 0"
                               Foreground="{DynamicResource InfoBannerLinkForeground}"
                               ToolTip.Tip="{x:Static res:UIStringResources.AboutWindow_MoreSponsorsTooltip}" />
                    <TextBlock Text="{Binding AnonymousSponsorsText}" VerticalAlignment="Center" Margin="6 0 0 0"
                               Foreground="{DynamicResource ControlSecondaryForeground}"
                               IsVisible="{Binding HasAnonymousSponsors}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Contributors -->
        <StackPanel Grid.Row="4" Margin="0 0 0 10" IsVisible="{Binding HasContributors}">
            <TextBlock Text="{x:Static res:UIStringResources.AboutWindow_ContributorsTitle}" FontWeight="SemiBold" Margin="0 0 0 6" />
            <Grid ColumnDefinitions="*,Auto">
                <ItemsControl Grid.Column="0" ItemsSource="{Binding Contributors}" MaxHeight="36" ClipToBounds="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sponsors:ContributorInfo">
                            <Border Margin="0 0 8 4" Padding="6 4" CornerRadius="4" BorderThickness="1"
                                    Background="{DynamicResource InfoBannerBackground}" BorderBrush="{DynamicResource InfoBannerBorder}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True" Background="#80808080">
                                        <Image controls:RemoteImageLoader.SourceUrl="{Binding AvatarUrl}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="..." VerticalAlignment="Center" FontWeight="Bold" Margin="4 0 0 0"
                               Foreground="{DynamicResource InfoBannerLinkForeground}"
                               ToolTip.Tip="{x:Static res:UIStringResources.AboutWindow_MoreContributorsTooltip}" />
                    <TextBlock Text="{Binding AnonymousContributorsText}" VerticalAlignment="Center" Margin="6 0 0 0"
                               Foreground="{DynamicResource ControlSecondaryForeground}"
                               IsVisible="{Binding HasAnonymousContributors}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- License (RichTextBox → SelectableTextBlock; 내용은 평문 string) -->
        <Grid Grid.Row="5" Margin="0 0 0 10" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="{x:Static res:UIStringResources.AboutWindow_OssLicenseText}" FontWeight="SemiBold" Margin="0 0 0 6" />
            <Border Grid.Row="1" BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource ControlDefaultBorderBrush}">
                <ScrollViewer Padding="6">
                    <SelectableTextBlock Text="{Binding LicenseDetails}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!--
            커스텀 Fluentv2 테마에는 MenuFlyoutPresenter/MenuItem 테마가 포함되지 않는다.
            따라서 부차 액션은 투명 Button으로 구성한 창 내부 패널로 표시한다.
        -->
        <Border x:Name="MoreActionsPanel"
                Grid.Row="0" Grid.RowSpan="7" ZIndex="100"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="78 0 0 38" Padding="5" MinWidth="190"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource ControlDefaultBorderBrush}"
                BorderThickness="1" CornerRadius="4" IsVisible="False">
            <StackPanel Spacing="2">
                <Button Theme="{DynamicResource TransparentButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10 6"
                        Content="{x:Static res:UIStringResources.Button_UserManualButton}" Click="MenuUserManual_Click" />
                <Button Theme="{DynamicResource TransparentButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10 6"
                        Content="{x:Static res:UIStringResources.Button_ShowSysInfoButton}" Click="MenuSystemInfo_Click" />
                <Button Theme="{DynamicResource TransparentButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10 6"
                        Content="{x:Static res:UIStringResources.Button_CheckUpdateButton}" Click="MenuCheckUpdate_Click" />
                <Button Theme="{DynamicResource TransparentButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10 6"
                        Content="{x:Static res:UIStringResources.Button_DiscordButton}" Click="MenuDiscord_Click" />
                <Border Height="1" Margin="4 3" Background="{DynamicResource ControlDefaultBorderBrush}" />
                <Button Theme="{DynamicResource TransparentButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10 6"
                        Content="{x:Static res:UIStringResources.Button_PrivacyLink}" Click="MenuPrivacy_Click" />
            </StackPanel>
        </Border>

        <!-- Buttons: 홈페이지 + 더 보기(⋯) | 확인 -->
        <Grid Grid.Row="6" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" HorizontalAlignment="Left" Orientation="Horizontal" Spacing="5">
                <Button Padding="10 4" Content="{x:Static res:UIStringResources.Button_OpenHomepageButton}" Click="OpenWebsiteButton_Click" />
                <Button Padding="12 4" Content="⋯" FontWeight="Bold" VerticalContentAlignment="Center"
                        Click="MoreButton_Click" />
            </StackPanel>
            <Button Grid.Column="1" HorizontalAlignment="Right" Padding="14 4" MinWidth="84" HorizontalContentAlignment="Center"
                    Content="{x:Static res:UIStringResources.Button_OkayButton}" IsDefault="True" Click="OkayButton_Click" />
        </Grid>
    </Grid>
</Window>
