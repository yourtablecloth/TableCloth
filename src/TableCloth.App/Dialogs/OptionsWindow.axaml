<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TableCloth.ViewModels"
        xmlns:config="using:TableCloth.Models.Configuration"
        xmlns:res="using:TableCloth.Resources"
        x:Class="TableCloth.Dialogs.OptionsWindow"
        x:DataType="vm:OptionsWindowViewModel"
        Title="{x:Static res:UIStringResources.Options_Title}" Width="680" Height="560" MinWidth="600" MinHeight="480"
        CanResize="False" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!-- 이슈 #296: 좌측 세로 탭(사이드바) — 상단 탭 헤더 공간 문제 해소. 이 창 한정으로 항목을 좌측 정렬·균일 폭으로. -->
    <Window.Styles>
        <Style Selector="TabItem">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinWidth" Value="130" />
        </Style>
    </Window.Styles>
    <Grid Margin="16" RowDefinitions="*,Auto">
        <!-- 이 창은 고정 크기(CanResize=False)라 탭 내용이 뷰포트를 넘으면 스크롤바 없이 잘린다.
             텍스트 배율(125%/150%)에서 실제로 재현되므로, 세로로 자랄 수 있는 탭은 예외 없이
             ScrollViewer 로 감싼다(가로 스크롤은 Disabled — 설명문이 줄바꿈되도록). -->
        <TabControl Grid.Row="0" TabStripPlacement="Left" SelectedIndex="{Binding InitialTabIndex, Mode=TwoWay}">
            <!-- 사용자 폴더 -->
            <TabItem Header="{x:Static res:UIStringResources.QuickStart_Section_UserFolders}">
                <Grid Margin="12" RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" Margin="0 0 0 8" TextWrapping="Wrap"
                               Foreground="{DynamicResource ControlSecondaryForeground}"
                               Text="{x:Static res:UIStringResources.MappedFolder_Description}" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding MappedFolders}" SelectedItem="{Binding SelectedMappedFolder}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="config:MappedFolderSetting">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding HostFolder}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding HostFolder}" />
                                    <Border Grid.Column="1" BorderThickness="1" CornerRadius="3" Padding="5 2" Margin="5 0 0 0"
                                            BorderBrush="{Binding ReadOnly, Converter={StaticResource BooleanToBackgroundConverter}}"
                                            IsVisible="{Binding !IsUnavailable}">
                                        <TextBlock Text="{Binding ReadOnly, Converter={StaticResource BooleanToReadOnlyTextConverter}}" FontSize="11" />
                                    </Border>
                                    <Border Grid.Column="1" BorderBrush="Red" BorderThickness="1" CornerRadius="3" Padding="5 2" Margin="5 0 0 0"
                                            IsVisible="{Binding IsUnavailable}">
                                        <TextBlock Text="{x:Static res:UIStringResources.MappedFolder_Unavailable}" Foreground="Red" FontSize="11" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0 8 0 0" Spacing="6">
                        <Button Content="{x:Static res:UIStringResources.MappedFolder_AddButton}" Command="{Binding AddMappedFolderCommand}" Padding="10 5" />
                        <Button Content="{x:Static res:UIStringResources.MappedFolder_RemoveButton}" Command="{Binding RemoveMappedFolderCommand}" IsEnabled="{Binding SelectedMappedFolder, Converter={StaticResource NullToBooleanConverter}}" Padding="10 5" />
                        <Button Content="{x:Static res:UIStringResources.MappedFolder_ToggleReadOnlyButton}" Command="{Binding ToggleMappedFolderReadOnlyCommand}" IsEnabled="{Binding SelectedMappedFolder, Converter={StaticResource NullToBooleanConverter}}" Padding="10 5" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 데이터 디렉터리 -->
            <TabItem Header="{x:Static res:UIStringResources.QuickStart_Section_DataDirectory}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <TextBlock Margin="0 0 0 8" TextWrapping="Wrap" Foreground="{DynamicResource ControlSecondaryForeground}"
                                   Text="{x:Static res:UIStringResources.QuickStart_DataDirectory_Description}" />
                        <TextBlock Margin="0 4 0 2" FontWeight="SemiBold" Text="{x:Static res:UIStringResources.QuickStart_DataDirectory_CurrentPathLabel}" />
                        <TextBox Margin="0 0 0 8" IsReadOnly="True" TextWrapping="Wrap" Text="{Binding DataDirectoryDisplayPath, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="{x:Static res:UIStringResources.QuickStart_DataDirectory_SelectButton}" Command="{Binding SelectDataDirectoryCommand}" Padding="10 5" />
                            <Button Content="{x:Static res:UIStringResources.QuickStart_DataDirectory_ResetButton}" Command="{Binding ResetDataDirectoryCommand}" IsEnabled="{Binding DataDirectoryIsCustom}" Padding="10 5" />
                            <Button Content="{x:Static res:UIStringResources.QuickStart_DataDirectory_OpenButton}" Command="{Binding OpenDataDirectoryCommand}" Padding="10 5" />
                        </StackPanel>
                        <Border Margin="0 10 0 0" BorderBrush="Red" BorderThickness="1" CornerRadius="3" Padding="8"
                                IsVisible="{Binding DataDirectoryIsNonLocal}">
                            <TextBlock TextWrapping="Wrap" Foreground="Red" Text="{x:Static res:UIStringResources.QuickStart_DataDirectory_NonLocalWarning}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 인증서 (NPKI 공유) -->
            <TabItem Header="{x:Static res:UIStringResources.Options_Section_Certificate}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <TextBlock Margin="0 0 0 8" TextWrapping="Wrap" Foreground="{DynamicResource ControlSecondaryForeground}"
                                   Text="{Binding CertificateSectionDescription}" />
                        <CheckBox Margin="0 4" Content="{x:Static res:UIStringResources.Option_ShareNpkiCheckbox}" IsChecked="{Binding ShareNpkiFolder}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 장치 공유 -->
            <TabItem Header="{x:Static res:UIStringResources.Options_Section_DeviceSharing}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <TextBlock Margin="0 0 0 8" TextWrapping="Wrap" Foreground="{DynamicResource ControlSecondaryForeground}"
                                   Text="{x:Static res:UIStringResources.Options_Section_DeviceSharing_Description}" />
                        <CheckBox Margin="0 4" Content="{x:Static res:UIStringResources.Option_UseMicrophoneCheckboxText}" IsChecked="{Binding EnableMicrophone}" />
                        <CheckBox Margin="0 4" Content="{x:Static res:UIStringResources.Option_UseWebCameraCheckboxText}" IsChecked="{Binding EnableWebCam}" />
                        <CheckBox Margin="0 4" Content="{x:Static res:UIStringResources.Option_UsePrinterCheckboxText}" IsChecked="{Binding EnablePrinters}" />
                        <TextBlock Margin="22 2 0 0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ControlSecondaryForeground}"
                                   Text="{x:Static res:UIStringResources.Option_UsePrinterCheckbox_Description}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 호환성 (워크어라운드) -->
            <TabItem Header="{x:Static res:UIStringResources.Options_Section_Compatibility}">
                <Grid Margin="12" RowDefinitions="Auto,Auto,*">
                    <TextBlock Grid.Row="0" Margin="0 0 0 8" TextWrapping="Wrap" Foreground="{DynamicResource ControlSecondaryForeground}"
                               Text="{x:Static res:UIStringResources.Options_Section_Compatibility_Description}" />
                    <TextBox Grid.Row="1" Margin="0 0 0 8" VerticalContentAlignment="Center"
                             Watermark="{x:Static res:UIStringResources.Option_Compatibility_SearchPlaceholder}"
                             Text="{Binding CompatibilityOptionSearchText}" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding CompatibilityOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CompatibilityOptionItem">
                                        <StackPanel Margin="0 0 0 12">
                                            <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                            <TextBlock Margin="22 2 0 0" TextWrapping="Wrap" FontSize="11"
                                                       Foreground="{DynamicResource ControlSecondaryForeground}"
                                                       Text="{Binding Description}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="2 4 0 0" TextWrapping="Wrap" Foreground="{DynamicResource ControlSecondaryForeground}"
                                       Text="{x:Static res:UIStringResources.Option_Compatibility_NoSearchResults}"
                                       IsVisible="{Binding HasNoCompatibilityMatches}" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 진단 -->
            <TabItem Header="{x:Static res:UIStringResources.Options_Section_Diagnostics}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <TextBlock Margin="0 0 0 8" TextWrapping="Wrap" Foreground="{DynamicResource ControlSecondaryForeground}"
                                   Text="{x:Static res:UIStringResources.Option_TelemetryDescriptionText}" />
                        <CheckBox Margin="0 4" Content="{x:Static res:UIStringResources.Option_UseAutoLogCollecting}" IsChecked="{Binding EnableLogAutoCollecting}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 미리 보기(Preview) -->
            <TabItem Header="{x:Static res:UIStringResources.Options_Section_Preview}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <TextBlock Margin="0 0 0 8" TextWrapping="Wrap" Foreground="{DynamicResource ControlSecondaryForeground}"
                                   Text="{x:Static res:UIStringResources.Options_Section_Preview_Description}" />

                        <!-- 이슈 #296: 업데이트 릴리스 링(안정/미리 보기). 안정=정식, 미리 보기=선행 프리릴리스(새 기능·변경을 먼저 검증). -->
                        <TextBlock Margin="0 4 0 2" FontWeight="SemiBold"
                                   Text="{x:Static res:UIStringResources.Option_UpdateChannel_Label}" />
                        <TextBlock Margin="0 0 0 4" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ControlSecondaryForeground}"
                                   Text="{x:Static res:UIStringResources.Option_UpdateChannel_Description}" />
                        <RadioButton Margin="0 2" GroupName="UpdateChannel"
                                     Content="{x:Static res:UIStringResources.Option_UpdateChannel_Retail}"
                                     IsChecked="{Binding SelectedUpdateChannel, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Retail, Mode=TwoWay}" />
                        <RadioButton Margin="0 2" GroupName="UpdateChannel"
                                     Content="{x:Static res:UIStringResources.Option_UpdateChannel_Preview}"
                                     IsChecked="{Binding SelectedUpdateChannel, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Preview, Mode=TwoWay}" />
                        <TextBlock Margin="22 2 0 0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ControlSecondaryForeground}"
                                   Text="{x:Static res:UIStringResources.Option_UpdateChannel_PreviewWarning}" />

                        <Border Height="1" Margin="0 12" Background="{DynamicResource ControlSecondaryForeground}" Opacity="0.25" />

                        <CheckBox Margin="0 4" Content="{x:Static res:UIStringResources.Option_EnableIdleAutoLogout}" IsChecked="{Binding EnableIdleAutoLogout}" />
                        <TextBlock Margin="22 2 0 0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ControlSecondaryForeground}"
                                   Text="{x:Static res:UIStringResources.Option_EnableIdleAutoLogout_Description}" />
                        <StackPanel Orientation="Horizontal" Margin="22 8 0 0" VerticalAlignment="Center" IsEnabled="{Binding EnableIdleAutoLogout}">
                            <TextBlock VerticalAlignment="Center" Margin="0 0 8 0" Text="{x:Static res:UIStringResources.Option_IdleAutoLogout_MinutesLabel}" />
                            <ComboBox Width="80" VerticalAlignment="Center" ItemsSource="{Binding IdleTimeoutOptions}" SelectedItem="{Binding IdleAutoLogoutMinutes}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="AI 스킬">
                <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="8">
                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{DynamicResource ControlSecondaryForeground}"
                               Text="식탁보 AI 전용 Codex 스킬을 관리합니다. 활성 스킬은 다음 대화에서 사용할 수 있습니다. 런타임을 재설치해도 스킬 폴더는 유지됩니다." />
                    <TextBlock Grid.Row="1" x:Name="AiSkillSummary" Text="{Binding SkillSummary}" FontWeight="SemiBold" />
                    <ListBox Grid.Row="2" x:Name="AiSkillList" ItemsSource="{Binding AiSkills}" SelectedItem="{Binding SelectedAiSkill}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SkillSettingsItem">
                                <StackPanel Margin="4" Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding StateLabel}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11"
                                               Foreground="{DynamicResource ControlSecondaryForeground}" />
                                    <TextBlock Text="{Binding Directory}" TextTrimming="CharacterEllipsis" FontSize="11"
                                               Foreground="{DynamicResource ControlSecondaryForeground}" ToolTip.Tip="{Binding Directory}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" IsEnabled="{Binding !SkillOperationBusy}">
                        <Button x:Name="AiSkillAdd" Content="스킬 추가" Command="{Binding AddAiSkillCommand}" Padding="10 5" />
                        <Button x:Name="AiSkillToggle" Content="{Binding SkillToggleLabel}" Command="{Binding ToggleAiSkillCommand}"
                                IsEnabled="{Binding SelectedAiSkill, Converter={StaticResource NullToBooleanConverter}}" Padding="10 5" />
                        <Button x:Name="AiSkillRemove" Content="스킬 제거" Command="{Binding RemoveAiSkillCommand}"
                                IsEnabled="{Binding SelectedAiSkill, Converter={StaticResource NullToBooleanConverter}}" Padding="10 5" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding !SkillOperationBusy}">
                            <Button x:Name="AiSkillRefresh" Content="목록 새로 고침" Command="{Binding RefreshSkillListCommand}" Padding="10 5" />
                            <Button x:Name="AiSkillFolder" Content="전용 폴더 열기" Command="{Binding OpenAiSkillFolderCommand}" Padding="10 5" />
                        </StackPanel>
                        <TextBlock x:Name="AiSkillNotice" Text="{Binding SkillNotice}" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource ControlSecondaryForeground}" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 12 0 0">
            <Button x:Name="CloseButton" Padding="14 6" Content="{x:Static res:UIStringResources.Options_CloseButton}" Click="CloseButton_Click" IsDefault="True" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
