<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Native AOT + trim analysis. Per-member warnings (not collapsed), do not fail build. -->
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Turn on the Roslyn-side analyzers so build-time IL warnings also surface. -->
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions pinned to Directory.Packages.props of TableCloth v1.20.6 -->
    <PackageReference Include="System.Management" Version="10.0.1" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
    <PackageReference Include="Sentry" Version="6.0.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.1" />
  </ItemGroup>
</Project>
